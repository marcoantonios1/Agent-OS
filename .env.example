# ── LLM gateway (required) ────────────────────────────────────────────────────
COSTGUARD_URL=http://host.docker.internal:8080
# COSTGUARD_API_KEY=your-api-key   # optional bearer token for the gateway
# COSTGUARD_TIMEOUT=5m             # per-request LLM timeout (default 60s); raise for large local models

# ── Agent models (optional) ───────────────────────────────────────────────────
# Model identifier passed to Costguard for each agent. Defaults to gemma4:26b.
# Tip: use a small fast model for the classifier and profile observer —
#      they only produce short structured output and don't need a large model.
#
# COMMS_MODEL=gemma4:26b
# BUILDER_MODEL=gemma4:26b
# RESEARCH_MODEL=gemma4:26b
# CLASSIFIER_MODEL=llama3.2:3b    # small model works well here — just outputs JSON
# PROFILE_MODEL=llama3.2:3b       # background personality observer — small + fast is fine

# ── Server (optional) ─────────────────────────────────────────────────────────
PORT=9091
LOG_LEVEL=info
SESSION_TTL=24h
BUILDER_SANDBOX_DIR=workspace

# ── Persistence ───────────────────────────────────────────────────────────────
# Path to the SQLite database. Without this, all data (profiles, projects,
# reminders, personality signals) is lost on restart.
SQLITE_PATH=./data/agentos.db

# ── Google (Gmail + Google Calendar) ─────────────────────────────────────────
# A single token covers both Gmail and Google Calendar.
# Obtain via: GOOGLE_CLIENT_ID=<id> GOOGLE_CLIENT_SECRET=<secret> go run ./cmd/tool/googleauth/
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# ── Microsoft (Outlook Mail + Outlook Calendar) ───────────────────────────────
# A single token covers both Outlook Mail and Outlook Calendar.
# Obtain via: MICROSOFT_CLIENT_ID=<id> go run ./cmd/tool/microsoftauth/
MICROSOFT_CLIENT_ID=your-app-id
MICROSOFT_REFRESH_TOKEN=your-refresh-token

# ── Discord channel ───────────────────────────────────────────────────────────
# Without DISCORD_BOT_TOKEN the server starts normally — Discord is just disabled.
# Create a bot at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_GUILD_ID=your-guild-id   # optional — limits bot to one server
# DISCORD_PREFIX=!ai               # optional — require prefix in server channels; DMs always routed

# ── WhatsApp channel ──────────────────────────────────────────────────────────
# Enables WhatsApp via the WA Web protocol. On first run a QR code is printed
# to the logs — scan it with WhatsApp → Linked Devices → Link a Device.
# The session is saved to WHATSAPP_STORE_PATH and survives restarts.
#
# WHATSAPP_ALLOWED_JID: only messages from this JID are handled.
# Format: <country-code><number>@s.whatsapp.net (e.g. 96170123456@s.whatsapp.net)
# To find your JID: leave WHATSAPP_ALLOWED_JID unset on first run — the server
# logs the JID of every incoming message so you can copy it.
WHATSAPP_STORE_PATH=whatsapp.db
WHATSAPP_ALLOWED_JID=96170123456@s.whatsapp.net

# ── Slack channel ─────────────────────────────────────────────────────────────
# Without SLACK_BOT_TOKEN the server starts normally — Slack is just disabled.
# Requires Socket Mode. See docs/slack-setup.md for full setup instructions.
#
# SLACK_BOT_TOKEN: bot OAuth token (xoxb-...) from api.slack.com/apps
# SLACK_APP_TOKEN: app-level token (xapp-...) — enable Socket Mode first
# SLACK_ALLOWED_USER_ID: your Slack member ID — only this user is served.
#   To find your ID: Slack → Profile → three-dot menu → Copy member ID
#
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USER_ID=U0123456789

# ── iMessage channel (BlueBubbles) ───────────────────────────────────────────
# Without BLUEBUBBLES_URL the server starts normally — iMessage is just disabled.
# Requires BlueBubbles Server running on a Mac with iMessage active.
# See docs/imessage-setup.md for full setup instructions.
#
# BLUEBUBBLES_URL: base URL of your BlueBubbles server (e.g. http://localhost:1234)
# BLUEBUBBLES_PASSWORD: the server password set in BlueBubbles preferences
# BLUEBUBBLES_ALLOWED_HANDLE: your iMessage phone number or email — only this handle is served.
#   Format: +15551234567  (international) or yourname@icloud.com (email)
# BLUEBUBBLES_WEBHOOK_PORT: local TCP port for the inbound webhook (default: 18789)
#
# BLUEBUBBLES_URL=http://localhost:1234
# BLUEBUBBLES_PASSWORD=your-server-password
# BLUEBUBBLES_ALLOWED_HANDLE=+15551234567
# BLUEBUBBLES_WEBHOOK_PORT=18789

# ── Telegram channel ──────────────────────────────────────────────────────────
# Without TELEGRAM_BOT_TOKEN the server starts normally — Telegram is disabled.
# Create a bot at: https://t.me/BotFather  →  /newbot
# TELEGRAM_ALLOWED_USER_ID: numeric Telegram user ID — only this user is served.
# To find your ID: message @userinfobot on Telegram.
#
# TELEGRAM_BOT_TOKEN=123456:ABCDEFabcdef...
# TELEGRAM_ALLOWED_USER_ID=123456789

# ── Voice (WhatsApp + Telegram) ───────────────────────────────────────────────
# Shared settings for the voice pipeline. Applies to any channel that receives
# audio (WhatsApp PTT voice notes, Telegram Voice messages).
#
# Transcription and TTS calls are proxied through Costguard (COSTGUARD_URL),
# which forwards them to a Whisper-compatible endpoint and an OpenAI-compatible
# TTS endpoint respectively. No separate URL is needed.
#
# VOICE_TRANSCRIPTION — set to "enabled" to turn on speech-to-text.
#   Requires a Whisper-compatible endpoint reachable from the container.
#   When unset the server starts normally and sends a "not supported" reply
#   if a voice message arrives.
#
# VOICE_TTS — set to "enabled" to synthesize agent replies back to audio.
#   When unset text replies are sent even if the inbound message was voice.
#
# VOICE_TTS_VOICE — voice name passed to the TTS endpoint (default: alloy).
#   Common values: alloy  nova  shimmer  echo  fable  onyx
#   Kokoro: af_heart  af_bella  am_adam  bf_emma  etc.
#
# VOICE_TTS_FORMAT — audio format returned by the TTS endpoint (default: opus).
#   "opus" (OGG/Opus) is required by WhatsApp and Telegram mobile.
#   Use "mp3" if your endpoint does not support opus.
#
# VOICE_TRANSCRIPTION=enabled
# VOICE_TTS=enabled
# VOICE_TTS_VOICE=alloy
# VOICE_TTS_FORMAT=opus

# ── Video processing ──────────────────────────────────────────────────────────
# Applies to any channel that receives video files (Telegram, WhatsApp, Slack).
# Requires ffmpeg to be available in the container (included by default in the
# official Docker image).
#
# VIDEO_MAX_FRAMES — maximum number of frames extracted from a video for LLM
#   analysis. Frames are spaced evenly across the video duration.
#   Default: 8. Lower this to reduce token usage for vision-capable models.
#
# VIDEO_MAX_SIZE_MB — maximum video file size (in MB) accepted for processing.
#   Videos larger than this are rejected before download with a user-friendly
#   message. Default: 50.
#
# VIDEO_MAX_FRAMES=8
# VIDEO_MAX_SIZE_MB=50

# ── Research Agent (web search) ───────────────────────────────────────────────
# Without SEARCH_API_KEY the Research Agent still starts but has no live search.
# Get a free key at: https://brave.com/search/api/
# SEARCH_API_KEY=your-brave-api-key
# SEARCH_PROVIDER=brave   # only "brave" is supported today

# ── Heartbeat worker ──────────────────────────────────────────────────────────
# A background worker that runs a prompt on a fixed interval and delivers the
# response to you via the configured channel (Discord or WhatsApp).
# Disabled by default — set HEARTBEAT_INTERVAL to enable.
#
# The prompt is resolved in this order:
#   1. {BUILDER_SANDBOX_DIR}/HEARTBEAT.md  — edit this file to change the checklist
#      without restarting. Copy it in with: docker compose cp HEARTBEAT.md agentos:/app/workspace/
#   2. HEARTBEAT_PROMPT env var             — fallback when no HEARTBEAT.md exists
#   3. Built-in default                    — "Check my emails for anything urgent
#                                            and summarize my calendar for today."
#
# HEARTBEAT_INTERVAL=30m                           # any Go duration: 30m, 1h, 2h
# HEARTBEAT_USER_ID=96170123456@s.whatsapp.net     # your user / WhatsApp JID
# HEARTBEAT_SESSION_ID=heartbeat                   # dedicated session (keeps history separate)
# HEARTBEAT_CHANNEL=whatsapp                       # discord | whatsapp | web
# HEARTBEAT_PROMPT=Check my emails and calendar.   # optional — overridden by HEARTBEAT.md

# ── Episodic memory ───────────────────────────────────────────────────────────
# Vector-backed long-term memory. Requires SQLITE_PATH to be set.
# After every conversation the router extracts memorable facts and saves them
# as embeddings. On future messages, relevant memories are injected into the
# agent's system prompt automatically.
#
# EPISODIC_MEMORY_ENABLED — set to "false" to disable injection (extraction
#   still runs; set EPISODIC_EXTRACTOR_MODEL="" to disable extraction too).
#   Default: enabled whenever SQLITE_PATH is set.
#
# EPISODIC_EXTRACTOR_MODEL — LLM model used to extract memories from transcripts.
#   Defaults to CLASSIFIER_MODEL. Use a small fast model.
#
# EMBEDDING_DIMENSIONS — vector size produced by your embedding model.
#   Default: 768. Must match the model served at COSTGUARD_URL.
#   Common values: 384 (nomic-embed-text-v1.5), 768 (mxbai-embed-large), 1536 (text-embedding-3-small)
#
# EPISODIC_MEMORY_K — number of memories retrieved per message (default: 5).
#
# EPISODIC_MEMORY_MAX_AGE — prune memories older than this (e.g. "90d").
#   Not yet enforced automatically — call the prune API to clean up manually.
#
# EPISODIC_MEMORY_ENABLED=true
# EPISODIC_EXTRACTOR_MODEL=llama3.2:3b
# EMBEDDING_DIMENSIONS=768
# EPISODIC_MEMORY_K=5
# EPISODIC_MEMORY_MAX_AGE=90d

# ── Inbox monitor ─────────────────────────────────────────────────────────────
# A background worker that polls your inbox on a fixed interval, uses an LLM to
# triage important emails, and delivers a notification via the configured channel.
# Requires an email provider (Google or Microsoft) and SQLITE_PATH to be set.
# Disabled by default — set INBOX_MONITOR_ENABLED=true to enable.
#
# INBOX_MONITOR_ENABLED=true
# INBOX_MONITOR_USER_ID=96170123456@s.whatsapp.net   # your user / WhatsApp JID
# INBOX_MONITOR_INTERVAL=15m                          # any Go duration: 5m, 15m, 1h
# INBOX_MONITOR_CHANNEL=whatsapp                      # whatsapp | discord | web (log-only)
# INBOX_MONITOR_MAX_EMAILS=20                         # emails fetched per check
# INBOX_MONITOR_MODEL=llama3.2:3b                     # use a non-thinking model — thinking models exhaust token budget before outputting JSON

# ── Calendar monitor ──────────────────────────────────────────────────────────
# A background worker that checks your calendar and sends enriched event briefs
# on a fixed schedule: the night before (20:00), then 1h and 30m before. Events
# from 12:00 also get a morning brief (08:00); events from 17:00 also get a noon
# brief (12:00). Each brief is sent once.
# Requires a calendar provider (Google or Microsoft) and SQLITE_PATH to be set.
# Disabled by default — set CALENDAR_MONITOR_ENABLED=true to enable.
#
# CALENDAR_MONITOR_ENABLED=true
# CALENDAR_MONITOR_USER_ID=96170123456@s.whatsapp.net   # your user / WhatsApp JID
# CALENDAR_MONITOR_CHANNEL=whatsapp                      # whatsapp | discord | web (log-only)
# CALENDAR_MONITOR_INTERVAL=5m                           # how often to poll (default 5m — max lateness of a brief)
# CALENDAR_MONITOR_LOOKAHEAD=48h                         # how far ahead to scan (default 48h)
# CALENDAR_MONITOR_TIMEZONE=Europe/Stockholm             # IANA zone for 20:00/08:00/12:00 briefs (default: container local, i.e. UTC)
# CALENDAR_MONITOR_MODEL=llama3.2:3b                     # use a non-thinking model

# ── Context compaction ────────────────────────────────────────────────────────
# Long sessions accumulate history that eventually exceeds model context limits.
# When history exceeds this estimated token count, older turns are automatically
# summarised and replaced with a single summary turn before dispatch.
# The 10 most recent turns are always kept verbatim.
# Set to 0 to disable compaction entirely.
#
# COMPACTION_THRESHOLD=6000   # default — lower this for models with small context windows
